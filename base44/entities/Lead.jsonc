{
  "name": "Lead",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "First name of the lead"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address"
    },
    "whatsapp": {
      "type": "string",
      "description": "WhatsApp number with country code"
    },
    "procedure": {
      "type": "string",
      "enum": [
        "Dental",
        "Bariatric",
        "Plastic",
        "Orthopedic",
        "Ophthalmology",
        "Just exploring"
      ],
      "description": "Procedure of interest"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "converted"
      ],
      "default": "new"
    }
  },
  "required": [
    "first_name",
    "email"
  ]
}